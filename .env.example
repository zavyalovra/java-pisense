# Скопируйте в .env

# Разработка на x86: только основной файл (датчики в режиме mock)
COMPOSE_FILE=docker-compose.yml
# На Raspberry Pi замените строкой выше на:
# COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml

BRIDGE_PROFILE=mock
POSTGRES_PASSWORD=pisense

# Каталог на хосте, где лежат файлы БД (вне Docker)
PISENSE_DATA_DIR=./data
# На Pi, например: PISENSE_DATA_DIR=/home/pi/pisense-data